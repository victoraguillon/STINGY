# Supabase — Stingy
# Copia este archivo a .env.local y completa con los valores del proyecto.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Solo para la CLI de Supabase en local. Nunca se expone al cliente.
SUPABASE_DB_PASSWORD=your-database-password

# Secreto compartido por el cron de tasas y la Edge Function.
# Genera uno con: openssl rand -hex 32
RATES_REFRESH_SECRET=change-me
